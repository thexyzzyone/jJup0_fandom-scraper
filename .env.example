# Settings for mcp_serve.py. Copy to .env (git-ignored) and set the key.

# Required: every MCP request must send "Authorization: Bearer <this key>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FANDOM_MCP_API_KEY=

# Bind address. 127.0.0.1 only accepts local connections; use 0.0.0.0 to
# accept connections from other machines (put TLS in front for anything
# beyond a trusted network: the key travels in a header).
FANDOM_MCP_HOST=127.0.0.1
FANDOM_MCP_PORT=8765

# Hive root to serve (default: hive/ next to mcp_serve.py)
# FANDOM_HIVE=/path/to/hive
